class Solution {
    public int maxProfit(int[] prices) {
        int minprice = Integer.MAX_VALUE;
        int maxprofit =0;
        for (int i=0; i<prices.length; i++){
            int price = prices[i];
            if(price < minprice){
                minprice =price;
            }else if ((price-minprice) > maxprofit){
                maxprofit = price - minprice;
            }


        }
        return maxprofit;
    }
}
